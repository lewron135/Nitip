# ══════════════════════════════════════════════════════════════
# JEJAK — contoh variabel lingkungan  (§14.4)
#
#   cp .env.example .env      lalu isi nilainya
#
# Berkas .env.example INI di-commit. Berkas .env TIDAK PERNAH.
# `gitleaks` di CI akan menggagalkan build kalau ada yang lolos.
# ══════════════════════════════════════════════════════════════

# ───────────────────────── RANTAI ─────────────────────────────
# WAJIB penyedia pihak ketiga. RPC publik resmi BSC menonaktifkan
# eth_getLogs, dan seluruh indexer kita adalah pembaca event (§14.5).
# Kandidat: dRPC, PublicNode, Chainstack, GetBlock, OnFinality, Ankr.
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
# Cadangan WAJIB diisi — pergantiannya dilatih, bukan diimprovisasi (RPC-5).
BSC_TESTNET_RPC_BACKUP=https://bsc-testnet.drpc.org
BSC_TESTNET_CHAIN_ID=97

# Alamat kontrak setelah deploy. Sumber kebenaran tetap
# contracts/deployments/bsc-testnet.json — ini hanya salinan praktis.
CONTRACT_ADDRESS=

# WAJIB. Blok saat kontrak di-deploy. Indexer mulai dari sini.
# JANGAN PERNAH backfill dari blok 0 (RPC-3).
DEPLOY_BLOCK=

# Paginasi eth_getLogs. Batas aman < 5.000 (galat -32005) — §14.5 RPC-2.
LOG_PAGE_SIZE=4500

# ────────────────── KUNCI (WALLET TESTNET SAJA) ───────────────
# JANGAN PERNAH memakai wallet yang berisi aset nyata (§23.1).
# Tanpa awalan 0x atau dengan awalan 0x, keduanya diterima.
DEPLOYER_PK=
VERIFIER_PK=
ARBITER_PK=

# ──────────────────────── LAYANAN ─────────────────────────────
# Untuk `forge script --verify` di testnet.bscscan.com
BSCSCAN_API_KEY=

# Kunci AI multimodal (Anthropic). Kalau KOSONG, verifier otomatis
# jalan di MOCK mode dengan fixture — seluruh demo tetap bisa jalan.
AI_API_KEY=
AI_MODEL=claude-opus-5

# Ambang keyakinan AI-1. Di bawah ini modal TIDAK dicairkan,
# kasus naik ke arbiter. Prinsip P2: AI menahan, tidak melonggarkan.
AI_CONFIDENCE_THRESHOLD=0.80

# Penyimpanan bukti. Kosongkan PINATA_JWT untuk fallback disk lokal (§11.7).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ────────────────────────── DEMO ──────────────────────────────
# true  = respons AI dibaca dari cache berkas, nol panggilan jaringan (§19)
# Wajib DIUJI sebelum Demo Day, bukan diasumsikan.
DEMO_MODE=false

# ───────────────────────── LAYANAN ────────────────────────────
VERIFIER_PORT=8787
INDEXER_DB_PATH=./services/data/jejak.db
# Interval polling indexer dalam detik.
INDEXER_POLL_SECONDS=15

# ──────────────────────── FRONTEND ────────────────────────────
# Variabel NEXT_PUBLIC_* terbaca di browser. Jangan taruh rahasia di sini.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
NEXT_PUBLIC_API_URL=http://localhost:8787
# WalletConnect project id (gratis di cloud.walletconnect.com).
# Boleh kosong: RainbowKit tetap jalan dengan injected wallet saja.
NEXT_PUBLIC_WALLETCONNECT_ID=
